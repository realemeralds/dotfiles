{
  xdg.userDirs = {
    enable = true;
    createDirectories = true; # Automatically creates the directory if it doesn't exist
    desktop = "$HOME/Desktop";
    download = "$HOME/Downloads";
    templates = "$HOME/Templates";
    publicShare = "$HOME/";
    documents = "$HOME/Documents";
    music = "$HOME/";
    pictures = "$HOME/Downloads"; # Change this to your preferred path
    videos = "$HOME/";
    projects = "$HOME/";
  };
}
